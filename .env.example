# ── Ace Data Cloud ──
ACE_API_KEY=your_ace_api_key_here

# ── EVM Wallet (for x402 payments — Category 2) ──
EVM_PRIVATE_KEY=your_evm_private_key_here

# ── Solana Keypair (for escrow payments — Category 1) ──
KEYPAIR_PATH=/path/to/your/solana-keypair.json

# ── Solana RPC (optional, defaults to mainnet-beta) ──
RPC_URL=https://api.mainnet-beta.solana.com

# ── Synapse Sentinel (Category 1) ──
SENTINEL_API_KEY=your_sentinel_key_here
SENTINEL_ENDPOINT=https://api.synapsesentinel.io/v1/assess

# ── Dry run mode (Category 1) — set to "true" to simulate escrow without real TXs ──
# DRY_RUN=true
